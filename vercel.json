{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "env": {
    "SITEWITNESS_PUBLIC_ANALYSIS": "false",
    "INFERENCE_ENABLED": "false",
    "INFERENCE_BUDGET_DRY_RUN": "false",
    "INFERENCE_DAILY_LIMIT": "0",
    "INFERENCE_USER_DAILY_LIMIT": "0",
    "INFERENCE_IP_DAILY_LIMIT": "0",
    "INFERENCE_CALL_LIMIT": "0"
  },
  "crons": [
    {
      "path": "/api/storage/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
