# Create this server-side key at https://dev.meta.ai
MODEL_API_KEY=
# Shared code for local single-host analysis when public mode is off.
SITEWITNESS_ACCESS_CODE=

# Public same-origin Preview analysis is off by default. Enable only after Neon
# budget migration/import and protected rate-limit settings have been verified.
SITEWITNESS_PUBLIC_ANALYSIS=false

# Keep false until a controlled inference is explicitly authorized.
INFERENCE_ENABLED=false
# Temporary hosted budget acceptance only; consumes persisted allowances, never calls Meta.
INFERENCE_BUDGET_DRY_RUN=false

# Shared durable request allowance per UTC day. 0 means no calls.
INFERENCE_DAILY_LIMIT=0
INFERENCE_USER_DAILY_LIMIT=0
# Anonymous public mode uses a keyed pseudonymous per-IP UTC-day allowance.
INFERENCE_IP_DAILY_LIMIT=0
# Existing durable lifetime ceiling. Reservations survive restart and are never refunded.
INFERENCE_CALL_LIMIT=0
# Automatic request throttles; public Preview policy uses finite values above
# zero, with a separate per-address burst/hour ceiling.
INFERENCE_IP_BURST_LIMIT=5
INFERENCE_IP_HOURLY_LIMIT=30
INFERENCE_GLOBAL_ATTEMPT_LIMIT=120
INFERENCE_GLOBAL_HOURLY_LIMIT=100
# Storage stays disabled unless explicitly enabled. Local disk is never used on Vercel.
INSPECTION_STORAGE_ENABLED=false
# Absolute, private directory OUTSIDE the checkout and served folders.
SITEWITNESS_DATA_DIR=
# 32 random bytes encoded as 64 hexadecimal characters; server-only.
SITEWITNESS_STORAGE_KEY=
# JSON array of {"id":"stable-user-id","tokenHash":"sha256-of-random-bearer-token"}.
# Tokens must be 32+ random bytes encoded as base64url; never put them in URLs.
SITEWITNESS_USERS=

# v0.9 remote snapshots: neon-blob (unset selects the existing local adapter).
SITEWITNESS_STORAGE_PROVIDER=
# Exact HTTPS origin, no trailing slash. Required for remote storage.
SITEWITNESS_PUBLIC_ORIGIN=
# Pooled Neon PostgreSQL URL, hostname containing -pooler. and ending .neon.tech.
# TLS certificate verification is mandatory; keep this server-only.
DATABASE_URL=
# Token for a PRIVATE Vercel Blob store; never NEXT_PUBLIC_*.
BLOB_READ_WRITE_TOKEN=
# At least 32 random characters; Vercel cron sends this as a bearer token.
CRON_SECRET=
