# Create this server-side key at https://dev.meta.ai
MODEL_API_KEY=
# Required before sharing a publicly deployed app. Users enter this in the UI.
SITEWITNESS_ACCESS_CODE=

# Keep false until a controlled inference is explicitly authorized.
INFERENCE_ENABLED=false

# This milestone also locks the live route in code. Never enable inference in preview.
# Lifetime call reservations; 0 means no calls. This is NOT a currency budget.
INFERENCE_CALL_LIMIT=0
# Optional single-host storage, never supported in Vercel functions.
INSPECTION_STORAGE_ENABLED=false
# Absolute, private directory OUTSIDE the checkout and served folders.
SITEWITNESS_DATA_DIR=
# 32 random bytes encoded as 64 hexadecimal characters; server-only.
SITEWITNESS_STORAGE_KEY=
# JSON array of {"id":"stable-user-id","tokenHash":"sha256-of-random-bearer-token"}.
# Tokens must be 32+ random bytes encoded as base64url; never put them in URLs.
SITEWITNESS_USERS=
