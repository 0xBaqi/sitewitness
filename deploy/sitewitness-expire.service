[Unit]
Description=Remove expired SiteWitness snapshots
RequiresMountsFor=/var/lib/sitewitness

[Service]
Type=oneshot
User=sitewitness
Group=sitewitness
WorkingDirectory=/opt/sitewitness/current
EnvironmentFile=/etc/sitewitness/sitewitness.env
Environment=NODE_ENV=production
Environment=INFERENCE_ENABLED=false
Environment=MODEL_API_KEY=
Environment=SITEWITNESS_ACCESS_CODE=
Environment=NEXT_TELEMETRY_DISABLED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sitewitness /opt/sitewitness/current/.next/cache
ExecStart=/usr/bin/env INFERENCE_ENABLED=false MODEL_API_KEY= SITEWITNESS_ACCESS_CODE= /opt/node24/bin/node --import tsx scripts/expire.ts
