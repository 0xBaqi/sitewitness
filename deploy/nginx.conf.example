# Include within nginx http context. Replace hostname and certificate paths.
limit_req_zone $binary_remote_addr zone=sitewitness:10m rate=30r/m;
server {
    listen 443 ssl;
    server_name inspections.example.invalid;
    ssl_certificate /etc/ssl/sitewitness/fullchain.pem;
    ssl_certificate_key /etc/ssl/sitewitness/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    # Required file; absent file fails nginx validation. Default contents deny all.
    # Direct DNS to this host only: do not put a CDN/proxy in front of this ACL.
    include /etc/nginx/sitewitness-preview-allowlist.conf;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    client_max_body_size 28m;
    client_body_timeout 15s;
    client_header_timeout 15s;
    access_log off;
    location / {
        limit_req zone=sitewitness burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
        proxy_cache off;
        proxy_buffering off;
        # Avoid writing private upload/response content into proxy temporary files.
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
    }
}
