# systemd EnvironmentFile syntax; replace all placeholders before use.
INSPECTION_STORAGE_ENABLED=true
SITEWITNESS_DATA_DIR=/var/lib/sitewitness
SITEWITNESS_PUBLIC_ORIGIN=https://REPLACE_WITH_HOSTNAME
SITEWITNESS_STORAGE_KEY=
SITEWITNESS_USERS='[{"id":"REPLACE_WITH_STABLE_USER_ID","tokenHash":"REPLACE_WITH_SHA256_HEX"}]'
# Defense in depth; service units also force inference off and clear credentials.
INFERENCE_ENABLED=false
INFERENCE_BUDGET_DRY_RUN=false
INFERENCE_DAILY_LIMIT=0
INFERENCE_USER_DAILY_LIMIT=0
INFERENCE_IP_DAILY_LIMIT=0
INFERENCE_CALL_LIMIT=0
INFERENCE_IP_BURST_LIMIT=5
INFERENCE_IP_HOURLY_LIMIT=30
INFERENCE_GLOBAL_ATTEMPT_LIMIT=120
INFERENCE_GLOBAL_HOURLY_LIMIT=100
SITEWITNESS_PUBLIC_ANALYSIS=false
MODEL_API_KEY=
SITEWITNESS_ACCESS_CODE=
NEXT_TELEMETRY_DISABLED=1
